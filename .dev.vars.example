# Template only. Put actual development values in ignored .dev.vars.development.
# Never copy a secret file or a local database URL from another workspace.
# Supabase-only authentication. Empty/missing values keep the Worker
# diagnostic-only. The service-role key is server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RIFF_MCP_RESOURCE=
RIFF_WEBSITE_ORIGIN=
# 64 hexadecimal characters (32 random bytes).
RIFF_AUTH_COOKIE_SECRET=
