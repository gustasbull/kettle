# Default fixture checks need no credentials. Do not copy development database URLs between workspaces.
# Evaluation scripts read exported process variables; Wrangler loads .dev.vars files separately.
# Optional: export KETTLE_PORT=8787 (Conductor's allocated port takes precedence).
# Stage 2 server-only configuration (see .dev.vars.example for the Worker):
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# RIFF_MCP_RESOURCE=
# RIFF_WEBSITE_ORIGIN=
# RIFF_AUTH_COOKIE_SECRET=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# REFERENCE_PROVIDER_API_KEY=
