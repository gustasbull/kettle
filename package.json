{
  "name": "kettle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "npm ci && node scripts/workspace.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "wrangler deploy --env \"\" --dry-run --outdir dist",
    "typecheck": "wrangler types && tsc --noEmit && tsc -p tsconfig.panel.json",
    "test": "node scripts/test.mjs",
    "test:db": "tsx --test tests/database.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:supabase": "tsx scripts/supabase-smoke.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke && npm run test:browser",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop",
    "db:reset": "node scripts/database.mjs reset",
    "db:status": "node scripts/database.mjs status",
    "eval:generation": "tsx evals/run.ts",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:test": "tsx scripts/supabase-local-smoke.ts",
    "build:development": "wrangler deploy --env development --dry-run --outdir dist/development",
    "build:panel": "node scripts/build-panel.mjs",
    "predev": "npm run build:panel",
    "prebuild": "npm run build:panel",
    "prebuild:development": "npm run build:panel",
    "pretypecheck": "npm run build:panel",
    "pretest": "npm run build:panel",
    "presmoke": "npm run build:panel",
    "test:browser": "node scripts/test.mjs --browser",
    "pretest:browser": "npm run build:panel"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/mcp-extensions": "^0.1.0",
    "@supabase/supabase-js": "2.117.3",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "supabase": "2.119.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.147.0"
  }
}
